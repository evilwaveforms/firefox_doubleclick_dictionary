{
  "manifest_version": 3,
  "name": "Double-click Dictionary",
  "version": "0.1.0",
  "description": "See an English definition when you double-click a word.",
  "icons": {
    "48": "icons/dictionary.svg",
    "96": "icons/dictionary.svg"
  },
  "action": {
    "default_title": "Double-click Dictionary",
    "default_icon": "icons/dictionary.svg",
    "default_popup": "settings.html",
    "default_area": "navbar"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [],
  "browser_specific_settings": {
    "gecko": {
      "id": "doubleclick-dictionary@evilwaveforms",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
